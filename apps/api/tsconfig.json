{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",

    // Nest usa decoradores y necesita que TS emita los metadatos de tipos
    // para poder inyectar dependencias por constructor.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // rootDir explícito: sin él, tsc infiere la raíz común de los archivos de
    // entrada y el output termina en dist/apps/api/src/, rompiendo dist/main.js.
    "rootDir": "./src",
    "outDir": "./dist",
    "sourceMap": true,

    // Sin "incremental": true a propósito. Nest borra dist/ en cada arranque
    // (deleteOutDir) pero tsc guarda su caché en apps/api/tsconfig.tsbuildinfo,
    // FUERA de dist/. La caché sobrevive al borrado, tsc cree que ya compiló
    // todo, no emite nada, y node falla con "Cannot find module dist/main".
    // En watch mode el estado vive en memoria, así que no perdemos velocidad.

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
