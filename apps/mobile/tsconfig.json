{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // El template de SDK 57 pone el código en src/. Aquí seguimos la
    // estructura del spec (app/ y lib/ en la raíz del paquete), así que el
    // alias apunta a la raíz.
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "env.d.ts",
    "nativewind-env.d.ts"
  ]
}